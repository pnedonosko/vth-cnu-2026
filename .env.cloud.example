# Copy this file to .env.cloud (gitignored) and fill in your GCP & Neon credentials.
GCP_PROJECT_ID=my-vth-student-project
GCP_REGION=europe-west3
ROSTER_JDBC_DATABASE_URL=jdbc:postgresql://ep-roster-endpoint.eu-central-2.aws.neon.tech/roster_db?sslmode=require
ANALYTICS_JDBC_DATABASE_URL=jdbc:postgresql://ep-analytics-endpoint.eu-central-2.aws.neon.tech/analytics_db?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=replace-with-neon-password
