# Copy this file to .env.cloud (gitignored) and fill in your GCP & Neon credentials.
GCP_PROJECT_ID=my-vth-student-project
GCP_REGION=europe-central2
JDBC_DATABASE_URL=jdbc:postgresql://ep-your-endpoint.eu-central-2.aws.neon.tech/roster_db?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=replace-with-neon-password
